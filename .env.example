# Copy this file to .env for local development. Never commit the real .env.

# Required in production. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Leave unset locally to use a SQLite file. On Heroku this is set for you.
# DATABASE_URL=postgresql://user:password@host:5432/library

# Library rules (these are the defaults)
# BORROW_FEE=30
# DEBT_LIMIT=500
# DEFAULT_STOCK=20
# CURRENCY=
